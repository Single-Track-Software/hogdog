// Cloudflare Workers Builds config: serves the built static site from site/.
// Build command in the Cloudflare dashboard: npm run build (draft) or npm run publish (launch).
// Every request runs worker/index.js first: trial-page headers and passwords, and the optional draft password.
{
  "name": "hogdog",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Draft lives at hogdog.<account>.workers.dev. Attach hogdogproductions.net as a custom domain at launch.
  "workers_dev": true
}
